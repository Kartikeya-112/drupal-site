{#
/**
 * @file
 * Header component.
 */
#}

<header class="header">
  <div class="nav-container">

    <div class="logo">
      <img src="{{ logo }}" alt="Site Logo">
    </div>

    <nav class="nav">
      {% for item in menu %}
        <a href="{{ item.url }}" class="nav-link {{ item.active ? 'active' }}">
          {{ item.title }}
        </a>
      {% endfor %}
    </nav>

  </div>
</header>