<section class="about">
  <div class="about-image">
    {% if image %}
      <img src="{{ image }}" alt="About Image">
    {% endif %}
  </div>

  <div class="about-text">
    <h2>About Us</h2>

    <h3>{{ subtitle }}</h3>

    <p>{{ body }}</p>

    {% if button_url %}
      <a href="{{ button_url }}" class="about-btn">
        {{ button_text }}
      </a>
    {% endif %}
  </div>
</section>