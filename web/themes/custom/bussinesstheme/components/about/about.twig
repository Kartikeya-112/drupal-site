<section class="about">
  <div class="about__container">

    <!-- Left Image -->
    <div class="about__image-wrapper">
      <div class="about__shape"></div>
      <div class="about__circle circle-one"></div>
      <div class="about__circle circle-two"></div>

      <img src="{{ image }}" alt="About image" class="about__image">
    </div>

    <!-- Right Content -->
    <div class="about__content">

      <h2 class="about__title">
        {{ title }}
      </h2>

      <h3 class="about__subtitle">
        {{ subtitle }}
      </h3>

      <p class="about__text">
        {{ description_one }}
      </p>

      <p class="about__text">
        {{ description_two }}
      </p>

      <a href="{{ button_link }}" class="about__btn">
        {{ button_text }} →
      </a>

    </div>

  </div>
</section>