<section class="contact">
  <div class="container">

    <!-- Heading -->
    <div class="contact-header">
      <h2>{{ title }}</h2>
      <p>{{ description }}</p>
    </div>

    <!-- Contact Cards -->
    <div class="contact-cards">
      {% for item in items %}
        <div class="contact-card">
          <div class="icon">
            {{ item.icon }}
          </div>
          <h4>{{ item.title }}</h4>
          <p>{{ item.text }}</p>
        </div>
      {% endfor %}
    </div>

    <!-- Contact Form -->
    <div class="contact-form">
      {{ form }}
    </div>

  </div>
</section>