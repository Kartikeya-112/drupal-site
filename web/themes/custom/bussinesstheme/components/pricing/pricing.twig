```twig
<section class="pricing">

  <div class="pricing__container">

    <h2 class="pricing__title">
      {{ content.body }}
    </h2>

    <div class="pricing__cards">

      {% for item in content.field_pricing_card %}
        <div class="pricing__card">

          <div class="pricing__card-header">
            <h3>{{ item.entity.field_product_type.value }}</h3>
          </div>

          <div class="pricing__price">
            {{ item.entity.field_rate.value }}
          </div>

          <ul class="pricing__features">
            {{ item.entity.field_products.value }}
          </ul>

          <div class="pricing__btn">
            <a href="{{ item.entity.field_button.uri }}">
              {{ item.entity.field_button.title }}
            </a>
          </div>

        </div>
      {% endfor %}

    </div>

  </div>

</section>
```
